  "inference_steps": [
    "1. features = MinMaxScaler.transform(raw_features)         # 严格沿用训练 fit 的 (data_min_, data_max_)",
    "2. logits = onnx.run({encounter_features, munition_id})     # 输出 (N, 4, 2)",
    "3. logits_adj = logits - logit_shifts_matrix               # 仅在同一概率空间联合校准后启用；当前通常为零矩阵",
    "4. probs = sigmoid(logits_adj)                             # (N, 4, 2)",
    "5. assert probs[:, :, 1] <= probs[:, :, 0]                 # 模型输出头天然保序，运行时只验证",
    "6. pred_level = 1·(p1>=thr1) + 1·((p1>=thr1) & (p2>=thr2)) # 返回 0/1/2 毁伤等级"
  ],
