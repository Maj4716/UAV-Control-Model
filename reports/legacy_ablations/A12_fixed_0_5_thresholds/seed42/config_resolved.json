{
  "experiment_id": "A12_fixed_0_5_thresholds",
  "description": "评估阶段强制所有8个阈值为0.5，检验阈值校准整体对部署性能的贡献。",
  "paths": {
    "data": "output/damage_dataset.parquet",
    "result_root": "abli_exp/results"
  },
  "data": {
    "use_physics_features": true,
    "use_soft_labels": true,
    "use_balanced_sampler": true,
    "use_adaptive_loss_balance": true,
    "pos_weight_mode": "per_munition"
  },
  "model": {
    "munition_emb_dim": 16,
    "use_munition_embedding": true,
    "use_munition_experts": true,
    "use_physics_skip": true,
    "use_k_cascade": true,
    "deep_m_branch": true
  },
  "loss": {
    "use_focal_loss": true,
    "use_ordinal_penalty": true,
    "use_class1_margin": true,
    "use_cell_class1_alpha": true
  },
  "calibration": {
    "threshold_strategy": "fixed_0_5"
  },
  "ablation": {
    "components": [
      "threshold_calibration"
    ],
    "note": "All L1/L2 decisions use fixed probability threshold 0.5."
  },
  "execution": {
    "reuse_train_from": "A0_full"
  },
  "resolved": {
    "seed": 42,
    "data": "D:\\Desktop\\new\\output\\damage_dataset.parquet",
    "output_dir": "D:\\Desktop\\new\\abli_exp\\results\\A12_fixed_0_5_thresholds\\seed42"
  }
}