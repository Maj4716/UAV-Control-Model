{
  "experiment_id": "A3_no_balanced_sampler",
  "description": "取消BalancedMunitionBatchSampler，训练集采用普通shuffle，检验分弹型等曝光采样对弱格样本的作用。",
  "paths": {
    "data": "output/damage_dataset.parquet",
    "result_root": "abli_exp/results"
  },
  "data": {
    "use_physics_features": true,
    "use_soft_labels": true,
    "use_balanced_sampler": false,
    "use_adaptive_loss_balance": true,
    "pos_weight_mode": "per_munition"
  },
  "model": {
    "munition_emb_dim": 16,
    "use_munition_embedding": true,
    "use_munition_experts": true,
    "use_physics_skip": true,
    "use_k_cascade": true,
    "deep_m_branch": true
  },
  "loss": {
    "use_focal_loss": true,
    "use_ordinal_penalty": true,
    "use_class1_margin": true,
    "use_cell_class1_alpha": true
  },
  "calibration": {
    "threshold_strategy": "per_munition"
  },
  "ablation": {
    "components": [
      "balanced_munition_batch_sampler"
    ],
    "note": "Adaptive loss balance is kept enabled to isolate the sampler effect."
  },
  "resolved": {
    "seed": 42,
    "data": "D:\\Desktop\\new\\output\\damage_dataset.parquet",
    "output_dir": "D:\\Desktop\\new\\abli_exp\\results\\A3_no_balanced_sampler\\seed42"
  }
}