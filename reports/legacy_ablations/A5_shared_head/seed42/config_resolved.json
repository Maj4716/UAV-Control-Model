{
  "experiment_id": "A5_shared_head",
  "description": "取消四个分弹型专家头，改用单一共享毁伤头，检验弹型专家路由对条件毁伤边界的贡献。",
  "paths": {
    "data": "output/damage_dataset.parquet",
    "result_root": "abli_exp/results"
  },
  "data": {
    "use_physics_features": true,
    "use_soft_labels": true,
    "use_balanced_sampler": true,
    "use_adaptive_loss_balance": true,
    "pos_weight_mode": "per_munition"
  },
  "model": {
    "munition_emb_dim": 16,
    "use_munition_embedding": true,
    "use_munition_experts": false,
    "use_physics_skip": true,
    "use_k_cascade": true,
    "deep_m_branch": true
  },
  "loss": {
    "use_focal_loss": true,
    "use_ordinal_penalty": true,
    "use_class1_margin": true,
    "use_cell_class1_alpha": true
  },
  "calibration": {
    "threshold_strategy": "per_munition"
  },
  "ablation": {
    "components": [
      "munition_expert_heads"
    ],
    "note": "Munition embedding is kept so the ablation targets the expert-head routing."
  },
  "resolved": {
    "seed": 42,
    "data": "D:\\Desktop\\new\\output\\damage_dataset.parquet",
    "output_dir": "D:\\Desktop\\new\\abli_exp\\results\\A5_shared_head\\seed42"
  }
}