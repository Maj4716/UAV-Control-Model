  },
  "loss": {
    "use_focal_loss": true,
    "use_ordinal_penalty": false,
    "use_class1_margin": false,
    "use_cell_class1_alpha": true
  },
  "calibration": {
    "threshold_strategy": "per_munition"
  },
  "ablation": {
    "components": [
      "ordinal_penalty",
      "class1_margin"
    ],
    "note": "BCE, task weighting, and focal settings are kept."
  },
  "resolved": {
    "seed": 42,
    "data": "D:\\Desktop\\new\\output\\damage_dataset.parquet",
    "output_dir": "D:\\Desktop\\new\\abli_exp\\results\\A10_no_ordinal_margin\\seed42"
  }
