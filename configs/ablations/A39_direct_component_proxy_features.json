{
  "experiment_id": "A39_direct_component_proxy_features",
  "description": "从零训练的直接任务代理：在A31的194维terminal_geometry_v2输入上追加102个可部署的逐部件解析破片/冲击波代理，检验分组汇总造成的信息损失；不读取仿真实现命中或部件标签。",
  "data": {
    "use_soft_labels": true,
    "use_label_uncertainty": true,
    "use_terminal_physics_features": true,
    "use_component_proxy_features": true,
    "use_mechanism_supervision": false,
    "use_component_supervision": false,
    "use_balanced_sampler": false,
    "use_adaptive_sampler_balance": false,
    "use_adaptive_loss_balance": false,
    "pos_weight_mode": "ones"
  },
  "model": {
    "base_input_dim": 296,
    "allow_component_proxy_direct_path": true,
    "use_munition_embedding": true,
    "use_munition_experts": true,
    "use_physics_skip": true,
    "use_k_cascade": true,
    "deep_m_branch": true,
    "ordinal_parameterization": "cumulative_logits",
    "use_mechanism_decomposition": false,
    "use_mechanism_auxiliary_heads": false,
    "use_component_auxiliary_heads": false
  },
  "loss": {
    "use_focal_loss": false,
    "use_ordinal_penalty": false,
    "use_class1_margin": false,
    "use_cell_class1_alpha": false,
    "use_class_distribution_loss": true,
    "class_distribution_weight": 0.25,
    "hard_level_classification_weight": 0.5
  },
  "calibration": {
    "threshold_strategy": "per_munition",
    "minimum_exact_class1_recall": 0.90,
    "maximum_class1_floor_accuracy_drop": null
  },
  "training": {
    "epochs": 45,
    "learning_rate": 0.001,
    "weight_decay": 0.0005,
    "minimum_selection_epochs": 32,
    "selection_patience": 10,
    "freeze_base_model": false,
    "freeze_criterion_uncertainty": false,
    "include_initial_candidate": false
  },
  "ablation": {
    "components": [
      "A31_dual_target_objective",
      "terminal_geometry_v2",
      "direct_per_component_analytic_proxies",
      "from_scratch_training",
      "sealed_test_split"
    ],
    "note": "新增102列完全由13维终端状态、弹型常数和公开车辆几何确定。该候选不加载A31/A35权重，避免未经验证的直接特征扩展迁移。"
  }
}
