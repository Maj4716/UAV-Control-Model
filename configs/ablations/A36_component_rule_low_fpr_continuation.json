  "ablation": {
    "components": [
      "verified_A35_component_continuation",
      "component_rule_low_fpr_entry_ranking",
      "component_rule_conditional_l1_l2_ranking",
      "validation_preregistered_sparse_fusion_v2"
    ],
    "note": "排序单元、权重、难负例比例和融合矩阵均由A35验证集诊断预注册；A36训练及候选选择期间测试标签保持封存。"
