{
  "experiment_id": "A36_component_rule_low_fpr_continuation",
  "description": "从已通过相对晋级的A35组件专家继续训练：冻结A31直接代理，仅对可微组件树施加分弹型低假阳性入口排序和L1/L2条件排序，并采用A35验证诊断预注册的稀疏融合矩阵。",
  "data": {
    "use_soft_labels": true,
    "use_label_uncertainty": true,
    "use_terminal_physics_features": true,
    "use_mechanism_supervision": false,
