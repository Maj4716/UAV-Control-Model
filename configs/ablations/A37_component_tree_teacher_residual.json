  "training": {
    "initial_checkpoint": "output/experiments/A35_independent_component_tree_fusion/seed{seed}/output/models/best_model.pth",
    "initial_manifest": "output/experiments/A35_independent_component_tree_fusion/seed{seed}/output/models/model_manifest.json",
    "freeze_base_model": true,
    "freeze_criterion_uncertainty": true,
    "epochs": 20,
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "minimum_selection_epochs": 10,
    "selection_patience": 6,
    "include_initial_candidate": true
  },
  "ablation": {
    "components": [
      "verified_A35_warm_start",
      "target_component_tree_teacher",
      "weak_cell_multiscale_residual_adapters",
      "direct_low_fpr_and_conditional_ranking"
    ],
    "note": "目标组件树仅由训练侧组件监督标签构造，不是输入特征；A35直接主干冻结，结构零不设适配器，测试集保持封存。"
  }
